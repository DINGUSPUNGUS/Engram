{
  "components": {
    "schemas": {
      "CreateMemoryRequest": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "memory_type": {
            "enum": ["fact", "preference", "project", "reference", "episodic"],
            "title": "Memory Type",
            "type": "string"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Derived from title when omitted",
            "title": "Slug"
          },
          "tags": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["title", "content", "memory_type"],
        "title": "CreateMemoryRequest",
        "type": "object"
      },
      "EditMemoryRequest": {
        "description": "Sparse edit; omitted fields stay unchanged.",
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "memory_type": {
            "anyOf": [
              {
                "enum": ["fact", "preference", "project", "reference", "episodic"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory Type"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": ["expected_version"],
        "title": "EditMemoryRequest",
        "type": "object"
      },
      "EventFeedResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EventResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next After"
          }
        },
        "required": ["items"],
        "title": "EventFeedResponse",
        "type": "object"
      },
      "EventResponse": {
        "properties": {
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "global_seq": {
            "title": "Global Seq",
            "type": "integer"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "stream_id": {
            "format": "uuid",
            "title": "Stream Id",
            "type": "string"
          },
          "stream_seq": {
            "title": "Stream Seq",
            "type": "integer"
          }
        },
        "required": [
          "global_seq",
          "event_id",
          "stream_id",
          "stream_seq",
          "event_type",
          "occurred_at",
          "actor"
        ],
        "title": "EventResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "LinkView": {
        "properties": {
          "relation": {
            "enum": ["relates_to", "supersedes", "derived_from", "contradicts"],
            "title": "Relation",
            "type": "string"
          },
          "target_id": {
            "format": "uuid",
            "title": "Target Id",
            "type": "string"
          }
        },
        "required": ["target_id", "relation"],
        "title": "LinkView",
        "type": "object"
      },
      "MemoryListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemoryResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": ["items"],
        "title": "MemoryListResponse",
        "type": "object"
      },
      "MemoryResponse": {
        "properties": {
          "archived": {
            "title": "Archived",
            "type": "boolean"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/LinkView"
            },
            "title": "Links",
            "type": "array"
          },
          "memory_type": {
            "enum": ["fact", "preference", "project", "reference", "episodic"],
            "title": "Memory Type",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "description": "Optimistic concurrency token; echo it in edits",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "content",
          "memory_type",
          "tags",
          "links",
          "archived",
          "created_at",
          "updated_at",
          "version"
        ],
        "title": "MemoryResponse",
        "type": "object"
      },
      "OpenProposalRequest": {
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "proposed_events": {
            "default": [],
            "description": "Serialized event envelopes this proposal wants to append",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Proposed Events",
            "type": "array"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["title"],
        "title": "OpenProposalRequest",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details \u2014 the error shape of every non-2xx response.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["title", "status"],
        "title": "Problem",
        "type": "object"
      },
      "ProposalListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProposalResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": ["items"],
        "title": "ProposalListResponse",
        "type": "object"
      },
      "ProposalResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "review_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Note"
          },
          "status": {
            "enum": ["draft", "pending", "approved", "rejected", "merged"],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": ["id", "title", "description", "status", "created_at", "updated_at"],
        "title": "ProposalResponse",
        "type": "object"
      },
      "ReviewRequest": {
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "title": "ReviewRequest",
        "type": "object"
      },
      "SearchHitResponse": {
        "properties": {
          "memory_id": {
            "format": "uuid",
            "title": "Memory Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["memory_id", "slug", "title", "snippet", "score"],
        "title": "SearchHitResponse",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/SearchHitResponse"
            },
            "title": "Hits",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          }
        },
        "required": ["query", "hits"],
        "title": "SearchResponse",
        "type": "object"
      },
      "TimelineEntryResponse": {
        "properties": {
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "stream_seq": {
            "title": "Stream Seq",
            "type": "integer"
