        },
        "required": ["event_id", "event_type", "occurred_at", "actor", "stream_seq"],
        "title": "TimelineEntryResponse",
        "type": "object"
      },
      "TimelineResponse": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/TimelineEntryResponse"
            },
            "title": "Entries",
            "type": "array"
          },
          "memory_id": {
            "format": "uuid",
            "title": "Memory Id",
            "type": "string"
          }
        },
        "required": ["memory_id", "entries"],
        "title": "TimelineResponse",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["version"],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Git-native, event-sourced, user-owned memory for AI assistants.",
    "title": "engram API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/rebuild": {
      "post": {
        "description": "Replay the event log through every projection from global_seq 0.",
        "operationId": "rebuild_projections_admin_rebuild_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Rebuild Projections Admin Rebuild Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Rebuild Projections",
        "tags": ["system"]
      }
    },
    "/api/v1/events": {
      "get": {
        "description": "Everything that happened, in order. Payloads are omitted here; use the\nmemory timeline endpoint for payload-level history of one memory.",
        "operationId": "event_feed_api_v1_events_get",
        "parameters": [
          {
            "description": "Return events after this global_seq",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Return events after this global_seq",
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventFeedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Event Feed",
        "tags": ["events"]
      }
    },
    "/api/v1/memories": {
      "get": {
        "description": "Cursor-paginated listing of current memory state.",
        "operationId": "list_memories_api_v1_memories_get",
        "parameters": [
          {
            "in": "query",
            "name": "memory_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": ["fact", "preference", "project", "reference", "episodic"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Memory Type"
            }
          },
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tag"
            }
          },
          {
            "in": "query",
            "name": "include_archived",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Archived",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "List Memories",
        "tags": ["memories"]
      },
      "post": {
        "description": "Create a memory; returns its immutable id and initial state.",
        "operationId": "create_memory_api_v1_memories_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMemoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          },
          "5XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Create Memory",
        "tags": ["memories"]
      }
    },
