    "/api/v1/memories/{memory_id}/timeline": {
      "get": {
        "description": "Full event history of one memory, oldest first.",
        "operationId": "memory_timeline_api_v1_memories__memory_id__timeline_get",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Memory Id",
              "type": "string"
