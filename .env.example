# engram configuration
# Precedence: built-in defaults < ~/.config/engram/config.toml < .env < environment.
# All variables are optional; defaults favor a zero-config local-first setup.

# Root directory for all engram state.
ENGRAM_DATA_DIR=~/.engram

# SQLite database (event log + projections). Canonical runtime state.
ENGRAM_DB_PATH=~/.engram/engram.db

# Git repository that receives the markdown + NDJSON event export.
# This is the user-owned, portable representation of the memory.
ENGRAM_EXPORT_REPO=~/.engram/memory

# API server. Binds to loopback by default (local-first; no auth yet).
ENGRAM_API_HOST=127.0.0.1
ENGRAM_API_PORT=8000

# Logging: DEBUG | INFO | WARNING | ERROR; format: console | json
ENGRAM_LOG_LEVEL=INFO
ENGRAM_LOG_FORMAT=console

# Environment name: development | production | test
ENGRAM_ENV=development

# LLM provider for the ingestion pipeline (roadmap phase 8; ADR-0012).
# ollama (local-first default) | claude | openai | gemini. Model is provider-specific.
ENGRAM_LLM_PROVIDER=ollama
ENGRAM_LLM_MODEL=

# Web dashboard (Next.js) — where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
