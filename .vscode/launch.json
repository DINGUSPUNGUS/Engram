{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (uvicorn, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["engram_api.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/api",
      "justMyCode": false
    },
    {
      "name": "CLI (engram --help)",
      "type": "debugpy",
      "request": "launch",
      "module": "engram_cli.main",
      "args": [],
      "cwd": "${workspaceFolder}/apps/cli"
    },
    {
      "name": "Web (next dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/apps/web"
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
